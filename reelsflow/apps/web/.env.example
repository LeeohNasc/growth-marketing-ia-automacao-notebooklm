# URL pública do app (usada em links de e-mail; nunca derivada do header Host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projeto Supabase (Settings → API). A publishable/anon key é pública por design;
# a proteção dos dados vem da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# SOMENTE SERVIDOR. Usada apenas para excluir a conta do usuário (auth admin).
# Nunca prefixar com NEXT_PUBLIC_. Opcional em desenvolvimento.
SUPABASE_SERVICE_ROLE_KEY=

# --- Integração Meta (Fase 4). Sem estas variáveis, o botão de conexão fica desativado. ---
# App Dashboard → Settings → Basic. O segredo é SOMENTE SERVIDOR.
# Instagram API with Instagram Login (contas do Instagram). Somente servidor.
# "Instagram App ID/Secret" do painel (API setup with Instagram login) — diferentes do App ID do Facebook.
# Redirect cadastrado na Meta: <NEXT_PUBLIC_SITE_URL>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=

# Facebook Login (somente Páginas do Facebook).
META_APP_ID=
META_APP_SECRET=
# Deve ser idêntica à cadastrada em Facebook Login → Valid OAuth redirect URIs.
# Padrão: ${NEXT_PUBLIC_SITE_URL}/api/oauth/meta/callback
META_REDIRECT_URI=
META_GRAPH_VERSION=v27.0
# Chave AES-256 (32 bytes em base64) para cifrar tokens. A MESMA no web e no worker.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Cobrança (Stripe Checkout + Billing) — PRIMEIRA VERSÃO, SOMENTE MODO DE TESTE ---
# Sem STRIPE_SECRET_KEY de teste + SUPABASE_SERVICE_ROLE_KEY, os botões de assinatura ficam ocultos/desativados.
# Chaves de produção (sk_live_) são recusadas pelo app nesta versão. SOMENTE SERVIDOR.
STRIPE_SECRET_KEY=sk_test_<sua-chave-de-teste>
# Segredo do endpoint de webhook (Dashboard → Webhooks, ou `stripe listen` em desenvolvimento).
# Endpoint: <NEXT_PUBLIC_SITE_URL>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_<segredo-do-endpoint>
# IDs dos preços de TESTE (gerados por `node scripts/stripe-test-setup.mjs`). Conferidos pelo servidor:
# BRL, mensal, Pro 99,90 · Business 299,90 · Premium 799,90. Anual: a definir (sem variável ainda).
STRIPE_PRICE_PRO_MONTHLY=price_<pro>
STRIPE_PRICE_BUSINESS_MONTHLY=price_<business>
STRIPE_PRICE_PREMIUM_MONTHLY=price_<premium>
# Configuração do portal do cliente (opcional; o script cria uma).
STRIPE_PORTAL_CONFIGURATION=
# Opcional: "fetch" para ambientes atrás de proxy HTTP (com NODE_USE_ENV_PROXY=1). Vazio = padrão do SDK.
STRIPE_HTTP_CLIENT=
