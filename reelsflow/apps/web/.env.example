# URL pública do app (usada em links de e-mail; nunca derivada do header Host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projeto Supabase (Settings → API). A publishable/anon key é pública por design;
# a proteção dos dados vem da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# SOMENTE SERVIDOR. Usada apenas para excluir a conta do usuário (auth admin).
# Nunca prefixar com NEXT_PUBLIC_. Opcional em desenvolvimento.
SUPABASE_SERVICE_ROLE_KEY=

# --- Integração Meta (Fase 4). Sem estas variáveis, o botão de conexão fica desativado. ---
# App Dashboard → Settings → Basic. O segredo é SOMENTE SERVIDOR.
META_APP_ID=
META_APP_SECRET=
# Deve ser idêntica à cadastrada em Facebook Login → Valid OAuth redirect URIs.
# Padrão: ${NEXT_PUBLIC_SITE_URL}/api/oauth/meta/callback
META_REDIRECT_URI=
META_GRAPH_VERSION=v27.0
# Chave AES-256 (32 bytes em base64) para cifrar tokens. A MESMA no web e no worker.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
