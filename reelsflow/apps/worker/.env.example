# Conexão direta ao Postgres (Supabase → Settings → Database → Connection string, modo "session").
# SOMENTE SERVIDOR. Necessária para FOR UPDATE SKIP LOCKED.
DATABASE_URL=postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# SOMENTE SERVIDOR.
SUPABASE_SERVICE_ROLE_KEY=
WORKER_CONCURRENCY=2
# Mesma chave do web (cifra dos tokens OAuth). Sem ela, publicações reais aguardam.
TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=v27.0
